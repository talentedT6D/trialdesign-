{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/*.js": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    { "source": "/api/create-order", "destination": "/api/create-order" },
    { "source": "/api/verify-payment", "destination": "/api/verify-payment" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
